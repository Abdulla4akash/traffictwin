  "research_questions": {
    "eventual": "Given a frozen vehicle actor that chooses only Local, V2I or V2V and does not observe current RSU load, when does downstream infrastructure-side load-aware placement improve, tie or harm task outcomes relative to strongest-link placement?",
    "e0": "Does the corrected evaluator account for every offered task and conserve service work before any controller comparison?",
    "e1": "How do the bundled legacy snapshot/clamp/legacy semantics and physical sequential/reject/conserved semantics behave at provisional 0.75x, 2.5x and 40x RSU waiting-room ceilings?",
    "not_tested": "The eventual load-aware-placement question is E2 and was not tested."
  },
  "hypotheses": [
    {
      "id": "E0-HV1",
      "kind": "validity",
      "statement": "The corrected physical evaluator conserves offered tasks as admitted plus explicit terminal rejection/unavailability outcomes and conserves V2I and vehicle service work.",
