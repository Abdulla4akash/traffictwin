      "status": "supported_for_the_repeated_10_step_smokes"
    },
    {
      "id": "E1-H1",
      "kind": "diagnostic",
      "statement": "Legacy clamp may hide work loss and change offered-task outcomes relative to physical rejection; no directional result was assumed.",
      "status": "the_bundled_semantic_paths_differed_at_all_three_caps_but_the_contrast_is_not_a_component_ablation"
    },
    {
      "id": "E1-H2",
      "kind": "directionally_agnostic_cap_tradeoff",
      "statement": "A lower waiting-room ceiling may reject work earlier and reduce queue latency; offered-task attainment may improve, tie or harm.",
